# =====================================================================
# J.A.R.V.I.S. — Exemple de variables d'environnement (voir docs/)
# Copier vers .env à côté du serveur. Ne jamais committer une clé réelle.
# =====================================================================

# --- Base PostgreSQL locale ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Cerveau Doubao (Volcengine Ark / BytePlus ModelArk, API compatible OpenAI) ---
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ID de endpoint (ep-...) OU nom de modèle fourni par la console Volcengine :
DOUBAO_MODEL=doubao-seed-1-6-flash-250615
# Modèle visuel (laisser vide = même modèle si multimodal) :
DOUBAO_VISION_MODEL=
# 1 = Doubao répond en premier ; 0 = après Ollama local et les clés gratuites
DOUBAO_FIRST=0

# --- Cascade de secours gratuite (optionnel, une clé suffit) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Ollama local (optionnel, 100 % privé) ---
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1

# --- Recherche fédérée (optionnel ; repli DDG + Wikipédia sinon) ---
# SEARXNG_URL=
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# SERPER_API_KEY=

# --- Domotique Home Assistant (optionnel) ---
# HOMEASSISTANT_URL=http://homeassistant.local:8123
# HOMEASSISTANT_TOKEN=
