<?xml version="1.0" encoding="utf-8"?>
<!--
  J.A.R.V.I.S. — client Android (PWA / interface mobile)
  Construit par android/build-apk.sh : aapt2 + javac + d8 + zipalign + apksigner.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.jarvis.complete"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="J.A.R.V.I.S."
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:allowBackup="true"
        android:largeHeap="true">
        <activity
            android:name="com.jarvis.complete.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
