# =====================================================================
# J.A.R.V.I.S. — FICHIER DE CLÉS
# Emplacement : C:\Program Files\Jarvis\app\.env
# (créé automatiquement à l'installation ; modifiez-le puis redémarrez
#  Jarvis via « Ouvrir Jarvis » — aucune fenêtre ne s'ouvre au bureau)
#
# Ne commitez jamais ce fichier. Ne le partagez jamais.
# =====================================================================

# --- Base PostgreSQL (fournie par le lanceur, à ne pas changer) ------
DATABASE_URL=postgresql://postgres@127.0.0.1:55432/app_db

# --- Cerveau Doubao (assistant personnel, Volcengine Ark) ------------
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-1-6-flash-250615
DOUBAO_VISION_MODEL=
# 1 = Doubao répond en premier ; 0 = après Ollama et les clés gratuites
DOUBAO_FIRST=0

# --- Cerveaux gratuits de repli (une seule clé suffit) ---------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Ollama local, 100 % privé ---------------------------------------
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
OLLAMA_MAX_PARAMS_B=6

# --- Recherche web (repli gratuit DuckDuckGo + Wikipédia) ------------
BRAVE_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
SEARXNG_URL=

# --- Domotique Home Assistant (optionnel) ----------------------------
HOMEASSISTANT_URL=
HOMEASSISTANT_TOKEN=
